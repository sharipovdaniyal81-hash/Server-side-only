--=====================================================================
-- R6 CONVERSION
--=====================================================================
local spawnMutex = false

local function ConvertToR6(player)
    while spawnMutex do task.wait(0.05) end
    spawnMutex = true

    local existing = StarterPlayer:FindFirstChild("StarterCharacter")
    if existing then existing:Destroy() end

    local d = Instance.new("HumanoidDescription")
    local ok, template = pcall(function()
        return Players:CreateHumanoidModelFromDescriptionAsync(d, Enum.HumanoidRigType.R6)
    end)
    d:Destroy()

    if not ok or not template then spawnMutex = false return end

    for _, c in template:GetChildren() do
        if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants")
            or c:IsA("ShirtGraphic") or c:IsA("BodyColors")
            or c:IsA("CharacterMesh") then
            c:Destroy()
        end
    end

    template.Name = "StarterCharacter"
    template.Parent = StarterPlayer

    player:LoadCharacter()
    task.wait(0.5)
    if template.Parent then template:Destroy() end
    spawnMutex = false

    task.spawn(function()
        local char = player.Character
        if not char then return end
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        local ok2, desc = pcall(function()
            return Players:GetHumanoidDescriptionFromUserIdAsync(player.UserId)
        end)
        if ok2 and desc then pcall(function() hum:ApplyDescription(desc) end) end
    end)
end

--=====================================================================
-- FREEZE / UNFREEZE
--=====================================================================
local freezeData = {}

local function FreezePlayer(target)
    local char = target.Character
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end
    freezeData[target] = {
        walk = hum.WalkSpeed, jumpPower = hum.JumpPower,
        jumpHeight = hum.JumpHeight, useJumpPower = hum.UseJumpPower,
    }
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    hum.JumpHeight = 0
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.Anchored = true end
    end
end

local function UnfreezePlayer(target)
    local char = target.Character
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.Anchored = false end
    end
    local data = freezeData[target]
    if data then
        hum.WalkSpeed = data.walk or 16
        hum.JumpPower = data.jumpPower or 50
        hum.JumpHeight = data.jumpHeight or 7.2
        hum.UseJumpPower = data.useJumpPower
    else
        hum.WalkSpeed = 16
        hum.JumpPower = 50
    end
    freezeData[target] = nil
end

--=====================================================================
