--=====================================================================
local function corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 3)
    c.Parent = parent
    return c
end

local function bevel(parent)
    local s1 = Instance.new("UIStroke")
    s1.Color = C.BORDER_DARK
    s1.Thickness = 2
    s1.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s1.Parent = parent

    local s2 = Instance.new("UIStroke")
    s2.Color = C.BORDER_LIGHT
    s2.Thickness = 1
    s2.Transparency = 0.5
    s2.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s2.Parent = parent
    return s1
end

local function padding(parent, top, bottom, left, right)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, top or 0)
    p.PaddingBottom = UDim.new(0, bottom or 0)
    p.PaddingLeft = UDim.new(0, left or 0)
    p.PaddingRight = UDim.new(0, right or 0)
    p.Parent = parent
end

local function listLayout(parent, spacing)
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, spacing or 4)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.HorizontalAlignment = Enum.HorizontalAlignment.Center
    l.Parent = parent
    return l
end

local function chunkyButton(parent, name, text, color, order, widthScale)
    local b = Instance.new("TextButton")
    b.Name = name
    b.Size = UDim2.new(widthScale or 1, 0, 0, 46)
    b.BackgroundColor3 = color
    b.Text = text
    b.TextColor3 = C.TEXT
    b.Font = Enum.Font.GothamBold
    b.TextSize = 16
    b.LayoutOrder = order
    b.AutoButtonColor = false
    b.Parent = parent

    b.TextStrokeTransparency = 0
    b.TextStrokeColor3 = C.BORDER_DARK

    corner(b, 3)
    bevel(b)

    local shade = Instance.new("Frame")
    shade.Size = UDim2.new(1, -4, 1, -4)
    shade.Position = UDim2.new(0, 2, 0, 2)
    shade.BackgroundTransparency = 0.85
    shade.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    shade.BorderSizePixel = 0
    shade.ZIndex = b.ZIndex - 1
    shade.Parent = b
    corner(shade, 3)

    b.MouseButton1Down:Connect(function()
        b.BackgroundColor3 = Color3.fromRGB(
            math.max(0, color.R * 255 - 40),
            math.max(0, color.G * 255 - 40),
            math.max(0, color.B * 255 - 40)
        )
    end)
    b.MouseButton1Up:Connect(function()
        b.BackgroundColor3 = color
    end)
    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = color
    end)

    return b
end

local function iconButton(parent, text, pos, size, color)
    local b = Instance.new("TextButton")
    b.Size = size or UDim2.new(0, 34, 0, 26)
    b.Position = pos
    b.BackgroundColor3 = color or C.BTN_BLUE
    b.Text = text
    b.TextColor3 = C.TEXT
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.AutoButtonColor = false
    b.TextStrokeTransparency = 0
    b.TextStrokeColor3 = C.BORDER_DARK
    b.Parent = parent
    corner(b, 3)
    bevel(b)
    return b
end

